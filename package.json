{
  "name": "metric-lp-detective",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit:rpc": "node --import tsx scripts/audit-rpc.ts",
    "verify:stage0:live": "node --import tsx scripts/verify-stage0-live.ts",
    "verify:source": "node scripts/compile-source.mjs && node scripts/verify-source.mjs",
    "verify:fixture": "node --import tsx scripts/verify-attribution.ts",
    "capture:attribution": "node --import tsx scripts/acquire-attribution.ts --refresh-logs",
    "scan:credentials": "node scripts/scan-credentials.mjs",
    "capture:history": "node --import tsx scripts/acquire-history.ts",
    "reconstruct:history": "node --import tsx scripts/reconstruct-history.ts",
    "verify:history": "node --import tsx scripts/verify-history.ts",
    "capture:oracle": "node --import tsx scripts/acquire-oracle-traces.ts",
    "verify:oracle": "node --import tsx scripts/verify-oracle.ts",
    "verify:performance": "node --import tsx scripts/verify-performance.ts && python3 scripts/verify_performance.py && python3 scripts/verify_position_performance.py",
    "check": "npm test && npm run typecheck && npm run verify:fixture && npm run verify:history && npm run verify:oracle && npm run verify:performance && npm run scan:credentials",
    "prepare:web": "node --max-old-space-size=4096 --import tsx scripts/prepare-web.ts",
    "dev": "npm run prepare:web && next dev --hostname 0.0.0.0",
    "prebuild": "npm run prepare:web",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test:e2e": "playwright test",
    "pretest": "npm run prepare:web",
    "check:client": "node scripts/check-client-bundle.mjs",
    "analyse:position": "node --max-old-space-size=4096 --import tsx scripts/analyse-position.ts",
    "verify:position": "node --max-old-space-size=4096 --import tsx scripts/verify-position.ts"
  },
  "dependencies": {
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "viem": "2.38.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "solc": "0.8.35",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
